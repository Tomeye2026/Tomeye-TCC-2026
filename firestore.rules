rules_version = '2';

// ============================================================
// TomEye — Firestore Security Rules
//
// Princípios:
// 1. Cada usuário só acessa seus próprios dados
// 2. Fazendas: o usuario_id na fazenda DEVE ser o uid do auth
// 3. Assinaturas: leitura e atualização pelo dono (necessário
//    para contratação de plano e incremento de uso)
// 4. Análises: só o dono pode criar e ler
// 5. plano_id no documento de USUARIO não pode ser alterado
//    diretamente pelo próprio usuário (é atualizado via
//    contratarPlano que altera na coleção assinaturas)
// 
// NOTA: Estas regras não verificam limites de plano (ex: max fazendas),
// pois Security Rules não suportam agregações entre coleções.
// A validação de limites é feita na camada de API (FazendasAPI.criar()).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── USUÁRIOS ─────────────────────────────────────────
    // Cada usuário pode ler e editar apenas seu próprio documento.
    // Criação é permitida (necessária no cadastro).
    // Administradores têm permissão explícita de list para carregar todos os usuários.
    match /usuarios/{userId} {
      // Leitura de documento individual (get):
      // Permitido para o próprio dono, admin, ou se a conta estiver ativa (login/perfil)
      allow get: if request.auth != null
        && (request.auth.uid == userId || isAdmin() || resource.data.ativo == true);
      allow get: if resource.data.ativo == true; // público para checagens pré-auth (login/recuperação)

      // Listagem da coleção inteira (list):
      // Permitido explicitamente para administradores autenticados
      allow list: if isAdmin();

      // Criação de perfil:
      // 1. O próprio usuário no cadastro (request.auth.uid == userId)
      // 2. O administrador do sistema
      // 3. O empregador (produtor ou empresa) cadastrando um funcionário vinculado
      allow create: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
        || (request.resource.data.tipo == 'funcionario' && (
             request.resource.data.empregador_id == request.auth.uid
             || request.resource.data.empresa_id == request.auth.uid
           ))
      );

      // Edição de perfil:
      // Admin pode editar qualquer usuário.
      // O próprio usuário pode editar seu perfil (sem alterar plano_id diretamente)
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == userId
            && request.resource.data.plano_id == resource.data.plano_id);

      allow delete: if isAdmin();
    }

    // ── FAZENDAS ─────────────────────────────────────────
    match /fazendas/{fazendaId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && (request.resource.data.usuario_id == request.auth.uid || isAdmin());
      allow update: if request.auth != null
        && (resource.data.usuario_id == request.auth.uid || isAdmin())
        && request.resource.data.usuario_id == resource.data.usuario_id;
      allow delete: if request.auth != null
        && (resource.data.usuario_id == request.auth.uid || isAdmin());
    }

    // ── ASSINATURAS ──────────────────────────────────────
    match /assinaturas/{assinaturaId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // ── ANÁLISES ─────────────────────────────────────────
    match /analises/{analiseId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── FUNCIONÁRIOS ─────────────────────────────────────
    // O empregador (empresa_id) e administradores podem gerenciar funcionários.
    match /funcionarios/{funcId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if request.auth != null
        && (request.resource.data.empresa_id == request.auth.uid || isAdmin());
      allow update: if request.auth != null
        && (resource.data.empresa_id == request.auth.uid || isAdmin());
      allow delete: if request.auth != null
        && (resource.data.empresa_id == request.auth.uid || isAdmin());
    }

    // ── NOTIFICAÇÕES ─────────────────────────────────────
    match /notificacoes/{notifId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── DOENÇAS (referência) ─────────────────────────────
    // Leitura pública para todos os autenticados.
    // Escrita apenas para admin.
    match /doencas/{doencaId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── CONFIGURAÇÕES ────────────────────────────────────
    // Leitura pública para todos os autenticados.
    // Escrita apenas para admin.
    match /configuracoes/{configId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── HELPER: verificar se é admin ─────────────────────
    function isAdmin() {
      return request.auth != null
        && (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'admin'
            || request.auth.token.email == 'admin@tomeye.com');
    }
  }
}
